{%- comment -%}
  ZIAK mobile header bar + slide-in drawer.
  Phones only — the desktop nav is untouched (this whole block is hidden at >=750px via CSS).
  Layout: [ wishlist · cart · search ]  ·  ZIAK logo  ·  ☰ hamburger
  Drawer holds the nav links + account (log in / sign up / log out).
{%- endcomment -%}

<div class="ziak-mnav" id="ziak-mnav">
  <!-- Left: lone icons -->
  <div class="ziak-mnav__icons">
    <a href="/pages/wishlist" class="ziak-mnav__icon ziak-wish-link" aria-label="Wishlist">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <span class="ziak-wish-count" data-ziak-wishlist-count style="display:none;">0</span>
    </a>
    <a href="{{ routes.cart_url }}" class="ziak-mnav__icon" aria-label="Cart">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    </a>
    <a href="{{ routes.search_url }}" class="ziak-mnav__icon" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </a>
  </div>

  <!-- Center: logo -->
  <a href="{{ routes.root_url }}" class="ziak-mnav__logo" aria-label="{{ shop.name | escape }}">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 240 | image_tag: alt: shop.name, class: 'ziak-mnav__logo-img', width: 96 }}
    {%- else -%}
      ZIAK
    {%- endif -%}
  </a>

  <!-- Right: hamburger -->
  <button class="ziak-mnav__burger" id="ziak-mnav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="ziak-mnav-drawer">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
</div>

<!-- Drawer + overlay (fixed; harmless on desktop, hidden via CSS) -->
<div class="ziak-mnav__overlay" id="ziak-mnav-overlay" hidden></div>
<aside class="ziak-mnav__drawer" id="ziak-mnav-drawer" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <div class="ziak-mnav__drawer-hd">
    <span class="ziak-mnav__drawer-title">Menu</span>
    <button class="ziak-mnav__drawer-close" id="ziak-mnav-close" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <nav class="ziak-mnav__links" aria-label="Mobile navigation">
    <a href="/collections/mens" class="ziak-mnav__link">Men</a>
    <a href="/pages/about" class="ziak-mnav__link">About</a>
    <a href="#" class="ziak-mnav__link">Stores</a>
    <a href="/pages/contact" class="ziak-mnav__link">Help</a>
    <a href="/pages/size-guide" class="ziak-mnav__link">Size Guide</a>
  </nav>

  <div class="ziak-mnav__account">
    {%- if customer -%}
      <a href="{{ routes.account_url }}" class="ziak-mnav__acct-line">My Account</a>
      <a href="{{ routes.account_logout_url }}" class="ziak-mnav__acct-btn ziak-mnav__acct-btn--outline">Log out</a>
    {%- else -%}
      <a href="{{ routes.account_login_url }}" class="ziak-mnav__acct-btn">Log in</a>
      <a href="{{ routes.account_register_url }}" class="ziak-mnav__acct-btn ziak-mnav__acct-btn--outline">Sign up</a>
    {%- endif -%}
  </div>
</aside>

<script>
  (function () {
    var burger  = document.getElementById('ziak-mnav-burger');
    var drawer  = document.getElementById('ziak-mnav-drawer');
    var overlay = document.getElementById('ziak-mnav-overlay');
    var closeBt = document.getElementById('ziak-mnav-close');
    if (!burger || !drawer || !overlay) return;

    function open() {
      overlay.hidden = false;
      requestAnimationFrame(function () {
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
      });
      drawer.setAttribute('aria-hidden', 'false');
      burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(function () { overlay.hidden = true; }, 320);
    }

    burger.addEventListener('click', open);
    if (closeBt) closeBt.addEventListener('click', close);
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
</script>
