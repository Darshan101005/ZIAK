{{ 'section-ziak-product-workshop.css' | asset_url | stylesheet_tag }}
<section class="ziak-workshop">
  <div class="ziak-workshop__copy"><p class="ziak-workshop__eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="ziak-workshop__body">{{ section.settings.body }}</div><a href="{{ section.settings.button_link | default: '/pages/shoemaking' }}">{{ section.settings.button_label }} <span>→</span></a><div class="ziak-workshop__proof">{%- for block in section.blocks -%}<div><i data-lucide="{{ block.settings.icon }}"></i><span>{{ block.settings.text }}</span></div>{%- endfor -%}</div></div>
  <div class="ziak-workshop__gallery"><div class="ziak-workshop__gallery-main">{%- if section.settings.image_main != blank -%}{{ section.settings.image_main | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'ZIAK workshop' }}{%- else -%}<span>ADD WORKSHOP IMAGE</span>{%- endif -%}</div><div>{%- if section.settings.image_leather != blank -%}{{ section.settings.image_leather | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'Leather materials' }}{%- else -%}<span>ADD IMAGE</span>{%- endif -%}</div><div>{%- if section.settings.image_stitching != blank -%}{{ section.settings.image_stitching | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'Craftsmanship' }}{%- else -%}<span>ADD IMAGE</span>{%- endif -%}</div><div>{%- if section.settings.image_shoes != blank -%}{{ section.settings.image_shoes | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'ZIAK shoes' }}{%- else -%}<span>ADD IMAGE</span>{%- endif -%}</div><div>{%- if section.settings.image_finish != blank -%}{{ section.settings.image_finish | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'Final inspection' }}{%- else -%}<span>ADD IMAGE</span>{%- endif -%}</div></div>
</section>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script><script>document.addEventListener('DOMContentLoaded',function(){if(typeof lucide!=='undefined')lucide.createIcons();});</script>
{% schema %}{"name":"Product workshop","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR WORKSHOP"},{"type":"text","id":"heading","label":"Heading","default":"Where ZIAK Shoes Come to Life."},{"type":"richtext","id":"body","label":"Body","default":"<p>We manufacture our own shoes in our facility, allowing us to focus on every detail — from material selection to the final finish. This helps us maintain consistent quality and footwear you can truly trust.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"EXPLORE OUR PROCESS"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"image_main","label":"Main workshop image"},{"type":"image_picker","id":"image_leather","label":"Leather image"},{"type":"image_picker","id":"image_stitching","label":"Stitching image"},{"type":"image_picker","id":"image_shoes","label":"Shoes image"},{"type":"image_picker","id":"image_finish","label":"Finishing image"}],"blocks":[{"type":"proof","name":"Proof point","settings":[{"type":"text","id":"icon","label":"Lucide icon","default":"package-check"},{"type":"text","id":"text","label":"Text","default":"In-House Production"}]}],"presets":[{"name":"Product workshop","blocks":[{"type":"proof","settings":{"icon":"package-check","text":"In-House Production"}},{"type":"proof","settings":{"icon":"shield-check","text":"Strict Quality Control"}},{"type":"proof","settings":{"icon":"users-round","text":"Skilled Craftsmen"}}]}]}{% endschema %}
