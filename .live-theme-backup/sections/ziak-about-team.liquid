{{ 'section-ziak-about-team.css' | asset_url | stylesheet_tag }}
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
<section class="ziak-team">
  <div class="ziak-team__top"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.description }}</div></div>
  <div class="ziak-team__grid">
    <div class="ziak-team__intro"><p>{{ section.settings.side_eyebrow }}</p><h3>{{ section.settings.side_heading }}</h3><div>{{ section.settings.side_text }}</div><span>{{ section.settings.side_quote }}</span></div>
    {%- for block in section.blocks -%}<article class="ziak-team__person" {{ block.shopify_attributes }}><div class="ziak-team__person-icon"><i data-lucide="{{ block.settings.icon }}"></i></div><h3>{{ block.settings.name }}</h3><p class="ziak-team__role">{{ block.settings.role }}</p><span></span><div class="ziak-team__bio">{{ block.settings.bio }}</div>{%- if block.settings.email != blank -%}{%- assign contact_lines = block.settings.email | split: '<br>' -%}<div class="ziak-team__contact"><i data-lucide="mail"></i><span>{%- for contact in contact_lines -%}{%- if contact contains '+' -%}<br><i data-lucide="phone"></i>{{ contact }}{%- else -%}{{ contact }}{% unless forloop.last %}<br>{% endunless %}{%- endif -%}{%- endfor -%}</span></div>{%- endif -%}</article>{%- endfor -%}
  </div>
  <div class="ziak-team__quote"><b>“</b><em>{{ section.settings.quote }}</em><strong>— {{ section.settings.quote_source }}</strong></div>
</section>
<script>document.addEventListener('DOMContentLoaded',function(){if(typeof lucide!=='undefined')lucide.createIcons();});</script>
{% schema %}{"name":"Team","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE TEAM BEHIND ZIAK"},{"type":"text","id":"heading","label":"Heading","default":"People who turned the vision into reality."},{"type":"textarea","id":"description","label":"Description","default":"ZIAK is the result of a collective effort — a team that brought together design, creativity, technology, and guidance to turn an idea into a brand."},{"type":"text","id":"side_eyebrow","label":"Side eyebrow","default":"OUR TEAM"},{"type":"text","id":"side_heading","label":"Side heading","default":"Different perspectives. One purpose."},{"type":"textarea","id":"side_text","label":"Side text","default":"ZIAK is not just a brand, it is the result of a collaboration between people with different skills, perspectives, and ideas. Each of us played a unique role in shaping the website, the visuals, the product experience, and the overall direction of ZIAK."},{"type":"text","id":"side_quote","label":"Side quote","default":"Steps, not statements."},{"type":"textarea","id":"quote","label":"Quote","default":"A brand is never built by one person, but by a team that believes in something greater."},{"type":"text","id":"quote_source","label":"Quote source","default":"ZIAK TEAM"}],"blocks":[{"type":"member","name":"Team member","settings":[{"type":"text","id":"icon","label":"Lucide icon","default":"laptop"},{"type":"text","id":"name","label":"Name","default":"Darshan V & V Deepak Roshan"},{"type":"text","id":"role","label":"Role","default":"WEBSITE DEVELOPMENT"},{"type":"textarea","id":"bio","label":"Bio","default":"Worked together to design and develop the entire website, bringing the brand’s vision to life through a clean, modern and seamless user experience."},{"type":"text","id":"email","label":"Email"}]}],"presets":[{"name":"Team","blocks":[{"type":"member","settings":{"icon":"laptop","name":"Darshan V & V Deepak Roshan","role":"WEBSITE DEVELOPMENT","bio":"Worked together to design and develop the entire website, bringing the brand’s vision to life through a clean, modern and seamless user experience.","email":"darshan.v@example.com"}},{"type":"member","settings":{"icon":"camera","name":"Chetanya Dhawan","role":"PHOTOGRAPHY & VISUALS","bio":"Provided all the images used on the website, including product photos, section visuals, and lifestyle shots. His guidance and creative direction helped shape the overall visual identity of ZIAK.","email":"chetanya.dhawan@example.com"}},{"type":"member","settings":{"icon":"pencil","name":"Shrija Agarwal","role":"DESIGNER","bio":"Designed the ZIAK shoe box, adding a unique and premium touch to the brand’s unboxing experience. She also created the brand mascot and brought together aesthetics, functionality and brand identity in a seamless way.","email":"shrija.agarwal@example.com"}},{"type":"member","settings":{"icon":"lightbulb","name":"Parth Vyas","role":"FOUNDER & GUIDANCE","bio":"The founder and driving force behind ZIAK. Provided constant guidance, support and valuable suggestions throughout the journey — from the initial concept to design, branding, and execution.","email":"parth.vyas@example.com"}}]}]}{% endschema %}
