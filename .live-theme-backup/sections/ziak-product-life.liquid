{{ 'section-ziak-product-life.css' | asset_url | stylesheet_tag }}
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
<section class="ziak-product-life">
  <div class="ziak-product-life__heading"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.description }}</div></div>
  <div class="ziak-product-life__layout">
    <div class="ziak-product-life__side ziak-product-life__side--left">
      {%- for block in section.blocks limit: 3 -%}<article class="ziak-product-life__card" {{ block.shopify_attributes }}><i data-lucide="{{ block.settings.icon }}"></i><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></article>{%- endfor -%}
    </div>
    <div class="ziak-product-life__visual">
      {%- if section.settings.center_image != blank -%}{{ section.settings.center_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.center_image.alt | default: 'ZIAK footwear' }}{%- else -%}<div class="ziak-product-life__placeholder"><i data-lucide="image"></i><span>ADD CENTRE IMAGE</span></div>{%- endif -%}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }} <i data-lucide="arrow-right"></i></a>
    </div>
    <div class="ziak-product-life__side ziak-product-life__side--right">
      {%- for block in section.blocks offset: 3 limit: 3 -%}<article class="ziak-product-life__card" {{ block.shopify_attributes }}><i data-lucide="{{ block.settings.icon }}"></i><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></article>{%- endfor -%}
    </div>
  </div>
</section>
<script>document.addEventListener('DOMContentLoaded',function(){if(typeof lucide!=='undefined')lucide.createIcons();});</script>
{% schema %}{"name":"Product life story","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHAT MAKES ZIAK DIFFERENT"},{"type":"text","id":"heading","label":"Heading","default":"Designed around your real life."},{"type":"richtext","id":"description","label":"Description","default":"<p>We combine everyday comfort, versatile style and practical design — so you can wear one pair for every part of your day, without compromises.</p>"},{"type":"image_picker","id":"center_image","label":"Centre image"},{"type":"text","id":"button_label","label":"Button label","default":"EXPLORE THE COLLECTION"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"point","name":"Life point","settings":[{"type":"text","id":"icon","label":"Lucide icon","default":"users-round"},{"type":"text","id":"title","label":"Title","default":"Customer Driven"},{"type":"textarea","id":"text","label":"Text","default":"We listen to your feedback to design shoes that truly solve everyday problems."}]}],"presets":[{"name":"Product life story","blocks":[{"type":"point","settings":{"icon":"users-round","title":"Customer Driven","text":"We listen to your feedback to design shoes that truly solve everyday problems."}},{"type":"point","settings":{"icon":"feather","title":"All-Day Comfort","text":"Cushioned support and a lightweight design to keep you comfortable from morning to night."}},{"type":"point","settings":{"icon":"layers-3","title":"Built to Last","text":"Premium materials and strong construction for everyday wear, travel and different terrains."}},{"type":"point","settings":{"icon":"sun-medium","title":"Made for Every Season","text":"Breathable and versatile design that keeps you comfortable in summer, rain or winter."}},{"type":"point","settings":{"icon":"footprints","title":"One Pair, Many Occasions","text":"A clean, modern look that fits work, college, travel, casual outings and celebrations."}},{"type":"point","settings":{"icon":"settings-2","title":"Solving Real Problems","text":"No more sore feet, stiff shoes or style limitations — ZIAK shoes are made to keep up with your daily life."}}]}]}{% endschema %}
