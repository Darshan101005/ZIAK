{{ 'section-ziak-product-features.css' | asset_url | stylesheet_tag }}

<!-- Lucide icons (same approach as the rest of the ZIAK sections) -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>

<section
  class="ziak-pfeat"
  id="ziak-product-features-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ziak-pfeat__wrap">
    <div class="ziak-pfeat__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="ziak-pfeat__item" {{ block.shopify_attributes }}>
            <span class="ziak-pfeat__icon"><i data-lucide="{{ block.settings.icon }}"></i></span>
            <div>
              <p class="ziak-pfeat__title">{{ block.settings.title }}</p>
              <p class="ziak-pfeat__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

{% schema %}
{
  "name": "ZIAK Product Features",
  "tag": "section",
  "class": "ziak-product-features-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck / shipping" },
            { "value": "rotate-ccw", "label": "Returns" },
            { "value": "shield-check", "label": "Shield check" },
            { "value": "award", "label": "Award" },
            { "value": "lock", "label": "Lock" },
            { "value": "headphones", "label": "Support" },
            { "value": "credit-card", "label": "Card" },
            { "value": "gem", "label": "Gem" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "default": "FREE SHIPPING",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "default": "On all prepaid orders",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZIAK Product Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "truck", "title": "FREE SHIPPING", "text": "On all prepaid orders" } },
        { "type": "feature", "settings": { "icon": "rotate-ccw", "title": "EASY RETURNS", "text": "7-day easy returns" } },
        { "type": "feature", "settings": { "icon": "shield-check", "title": "SECURE PAYMENTS", "text": "Safe & trusted payments" } },
        { "type": "feature", "settings": { "icon": "award", "title": "QUALITY ASSURED", "text": "Crafted to last" } }
      ]
    }
  ]
}
{% endschema %}
