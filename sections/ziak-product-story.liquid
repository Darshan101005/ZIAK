{{ 'section-ziak-product-story.css' | asset_url | stylesheet_tag }}

<!-- Lucide icons (same approach as the rest of the ZIAK sections) -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>

<section
  class="ziak-pstory"
  id="ziak-product-story-{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ziak-pstory__inner {% if section.settings.image_position == 'left' %}ziak-pstory__inner--reverse{% endif %}">

    <!-- ── Text ── -->
    <div class="ziak-pstory__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ziak-pstory__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ziak-pstory__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="ziak-pstory__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ziak-pstory__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' -%}
              <li class="ziak-pstory__point" {{ block.shopify_attributes }}>
                <span class="ziak-pstory__point-icon"><i data-lucide="{{ block.settings.icon }}"></i></span>
                <span class="ziak-pstory__point-text">
                  {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong>{%- endif -%}
                  {{ block.settings.text }}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <a href="{{ section.settings.button_url }}" class="ziak-pstory__btn">
          <span>{{ section.settings.button_label }}</span>
          <i data-lucide="arrow-right"></i>
        </a>
      {%- endif -%}
    </div>

    <!-- ── Image (added by user) with hover zoom ── -->
    <div class="ziak-pstory__media-wrap">
      <div class="ziak-pstory__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 900, 1200',
              class: 'ziak-pstory__img',
              alt: section.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'ziak-pstory__img ziak-pstory__img--placeholder' }}
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

{% schema %}
{
  "name": "ZIAK Product Story",
  "tag": "section",
  "class": "ziak-product-story-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "THE ZIAK DIFFERENCE",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Built To Move With You",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "default": "<p>This isn't just another pair of shoes. It's the product of premium materials, thoughtful design, and craftsmanship refined over generations — made to look better with every step you take.</p>",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (added by you)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ]
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#FFFFFF",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Feature point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "check-circle", "label": "Check circle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "feather", "label": "Feather" },
            { "value": "shield-check", "label": "Shield check" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "gem", "label": "Gem" },
            { "value": "footprints", "label": "Footprints" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Bold title (optional)"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Full-grain leather that ages beautifully.",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZIAK Product Story",
      "blocks": [
        { "type": "point", "settings": { "icon": "check-circle", "title": "Premium materials. ", "text": "Full-grain leather that ages beautifully." } },
        { "type": "point", "settings": { "icon": "feather", "title": "All-day comfort. ", "text": "Cushioned footbed for lasting support." } },
        { "type": "point", "settings": { "icon": "shield-check", "title": "Made to last. ", "text": "Durable construction backed by our craft." } }
      ]
    }
  ]
}
{% endschema %}
