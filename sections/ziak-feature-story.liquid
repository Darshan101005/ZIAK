{{ 'section-ziak-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-ziak-feature-story.css' | asset_url | stylesheet_tag }}

<style>
  .shopify-section-group-header-group { display: none !important; }
  body { background-color: #FFFFFF !important; }

  #ziak-feature-nav {
    position: relative !important;
    top: auto !important; left: auto !important; right: auto !important;
    background: #FFFFFF !important;
    border-bottom: 1px solid #E8E8E8 !important;
  }
  #ziak-feature-nav .ziak-hero__nav-link,
  #ziak-feature-nav .ziak-hero__nav-link--dropdown { color: #1A1A1A !important; }
  #ziak-feature-nav .ziak-hero__nav-link--dropdown::after { border-top-color: #1A1A1A !important; }
  #ziak-feature-nav .ziak-hero__nav-icon { color: #1A1A1A !important; opacity: 1 !important; }
  #ziak-feature-nav .ziak-hero__nav-icon svg { stroke: #1A1A1A !important; }
  #ziak-feature-nav .ziak-hero__logo-placeholder { color: #1A1A1A !important; opacity: 1 !important; }
  #ziak-feature-nav .ziak-hero__logo-img { filter: none !important; }
  #ziak-feature-nav .ziak-hero__mega-menu {
    position: fixed !important; top: auto !important; left: 0 !important; right: 0 !important; width: 100vw !important;
  }
</style>

<!-- ══════════ ANNOUNCEMENT + HEADER (About-page style) ══════════ -->
<div class="ziak-hero__announcement" id="ziak-feature-announcement" style="background:#1A1A1A;color:#FFFFFF;">
  <span>{{ section.settings.announcement_text | default: 'FREE SHIPPING ON ALL ORDERS OVER ₹999 — ALL OVER INDIA' }}</span>
</div>

<div class="ziak-hero" id="ziak-feature-hero" style="min-height:auto;background:#FFFFFF;">
  {%- render 'ziak-mobile-nav' -%}
  <nav class="ziak-hero__nav" id="ziak-feature-nav" aria-label="Main navigation" style="background:#FFFFFF;border-bottom:1px solid #E8E8E8;">
    <div class="ziak-hero__nav-left">
      <div class="ziak-hero__dropdown-wrapper">
        <a href="/collections/all" class="ziak-hero__nav-link ziak-hero__nav-link--dropdown" style="color:#1A1A1A;">MEN</a>
        {%- render 'ziak-mega-menu' -%}
      </div>
      <a href="/pages/about" class="ziak-hero__nav-link" style="color:#1A1A1A;">ABOUT</a>
    </div>
    <div class="ziak-hero__nav-center">
      <a href="{{ routes.root_url }}" class="ziak-hero__logo-placeholder" style="color:#1A1A1A;">
        {%- if settings.logo_svg_url != blank -%}
          <img src="{{ settings.logo_svg_url }}" alt="{{ shop.name | escape }}" class="ziak-hero__logo-img" width="120">
        {%- elsif settings.logo != blank -%}
          {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, class: 'ziak-hero__logo-img', width: 110 }}
        {%- else -%}ZIAK{%- endif -%}
      </a>
    </div>
    <div class="ziak-hero__nav-right">
      <a href="/pages/our-store" class="ziak-hero__nav-link" style="color:#1A1A1A;">STORES</a>
      <a href="/pages/contact" class="ziak-hero__nav-link" style="color:#1A1A1A;">HELP</a>
      <a href="/pages/wishlist" class="ziak-hero__nav-icon ziak-wish-link" aria-label="Wishlist" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="ziak-wish-count" data-ziak-wishlist-count style="display:none;">0</span>
      </a>
      <a href="{{ routes.account_url }}" class="ziak-hero__nav-icon" aria-label="Account" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M18 20a6 6 0 0 0-12 0"/><circle cx="12" cy="10" r="4"/></svg>
      </a>
      <a href="{{ routes.search_url }}" class="ziak-hero__nav-icon" aria-label="Search" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="ziak-hero__nav-icon" aria-label="Cart" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
      </a>
    </div>
  </nav>
</div>

<!-- ══════════ FEATURE STORY ══════════ -->
<article class="ziak-feature">

  <!-- Hero -->
  <header class="ziak-feature__hero">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ziak-feature__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="ziak-feature__title">{{ section.settings.heading | default: 'The Art of Shoemaking' }}</h1>
    <div class="ziak-feature__meta">
      {%- if section.settings.date != blank -%}<span>{{ section.settings.date }}</span>{%- endif -%}
      {%- if section.settings.read_time != blank -%}<span class="ziak-feature__dot">·</span><span>{{ section.settings.read_time }}</span>{%- endif -%}
    </div>
    {%- if section.settings.intro != blank -%}
      <div class="ziak-feature__lead">{{ section.settings.intro }}</div>
    {%- endif -%}
  </header>

  <!-- Hero image (full-bleed) -->
  <figure class="ziak-feature__hero-media">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'ziak-feature__img', sizes: '100vw', widths: '600,900,1200,1600,2200' }}
    {%- else -%}
      <div class="ziak-feature__ph ziak-feature__ph--hero"><span>{{ section.settings.hero_ph_label | default: 'Add hero image' }}</span></div>
    {%- endif -%}
  </figure>

  <!-- Body blocks -->
  <div class="ziak-feature__body">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          <h2 class="ziak-feature__subhead" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

        {%- when 'text' -%}
          <div class="ziak-feature__rich" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'quote' -%}
          <blockquote class="ziak-feature__quote" {{ block.shopify_attributes }}>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.cite != blank -%}<cite>{{ block.settings.cite }}</cite>{%- endif -%}
          </blockquote>

        {%- when 'image' -%}
          <figure class="ziak-feature__figure{% if block.settings.width == 'wide' %} ziak-feature__figure--wide{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'ziak-feature__img', sizes: '100vw', widths: '600,900,1200,1600,2000' }}
            {%- else -%}
              <div class="ziak-feature__ph ziak-feature__ph--img"><span>{{ block.settings.ph_label | default: 'Add image' }}</span></div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>

        {%- when 'duo' -%}
          <div class="ziak-feature__duo{% if block.settings.layout == 'image_right' %} ziak-feature__duo--rev{% endif %}" {{ block.shopify_attributes }}>
            <div class="ziak-feature__duo-media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ziak-feature__img', sizes: '(max-width: 749px) 100vw, 50vw', widths: '500,800,1100,1400' }}
              {%- else -%}
                <div class="ziak-feature__ph ziak-feature__ph--img"><span>{{ block.settings.ph_label | default: 'Add image' }}</span></div>
              {%- endif -%}
            </div>
            <div class="ziak-feature__duo-text">
              {%- if block.settings.subheading != blank -%}<h3 class="ziak-feature__duo-title">{{ block.settings.subheading }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="ziak-feature__rich">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </div>

        {%- when 'video' -%}
          <figure class="ziak-feature__video-wrap" {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '1600x', loop: false, controls: true, muted: false, class: 'ziak-feature__video' }}
            {%- elsif block.settings.video_url != blank -%}
              <div class="ziak-feature__video-embed">{{ block.settings.video_url | external_video_tag }}</div>
            {%- else -%}
              <div class="ziak-feature__ph ziak-feature__ph--video">
                <span class="ziak-feature__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="8 5 19 12 8 19 8 5"/></svg>
                </span>
                <span class="ziak-feature__ph-text">{{ block.settings.ph_label | default: 'Add video' }}</span>
              </div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <!-- Closing CTA -->
  {%- if section.settings.cta_heading != blank or section.settings.cta_label != blank -%}
    <section class="ziak-feature__cta">
      {%- if section.settings.cta_heading != blank -%}<h2 class="ziak-feature__cta-title">{{ section.settings.cta_heading }}</h2>{%- endif -%}
      {%- if section.settings.cta_text != blank -%}<div class="ziak-feature__cta-text">{{ section.settings.cta_text }}</div>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ziak-feature__cta-btn">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </section>
  {%- endif -%}

  <!-- Back link -->
  <div class="ziak-feature__foot">
    <a href="{{ section.settings.back_url | default: '/pages/blog' }}" class="ziak-feature__back">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      {{ section.settings.back_label | default: 'BACK TO THE JOURNAL' }}
    </a>
  </div>

</article>

{% schema %}
{
  "name": "ZIAK Feature Story",
  "tag": "section",
  "class": "ziak-feature-section",
  "settings": [
    { "type": "header", "content": "Top Bar" },
    { "type": "text", "id": "announcement_text", "default": "FREE SHIPPING ON ALL ORDERS OVER ₹999 — ALL OVER INDIA", "label": "Announcement" },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "default": "FEATURED", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "default": "The Art of Shoemaking", "label": "Title" },
    { "type": "text", "id": "date", "default": "AUG 2026", "label": "Date" },
    { "type": "text", "id": "read_time", "default": "6 MIN READ", "label": "Read time" },
    { "type": "richtext", "id": "intro", "label": "Intro / Lead paragraph" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_ph_label", "default": "Add hero image", "label": "Hero placeholder label" },

    { "type": "header", "content": "Closing CTA" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading" },
    { "type": "richtext", "id": "cta_text", "label": "CTA text" },
    { "type": "text", "id": "cta_label", "label": "CTA button label" },
    { "type": "url", "id": "cta_url", "label": "CTA button link" },

    { "type": "header", "content": "Back Link" },
    { "type": "text", "id": "back_label", "default": "BACK TO THE JOURNAL", "label": "Back link label" },
    { "type": "url", "id": "back_url", "label": "Back link", "info": "Defaults to /pages/blog" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Subheading",
      "settings": [
        { "type": "text", "id": "text", "default": "Section heading", "label": "Text" }
      ]
    },
    {
      "type": "text",
      "name": "Paragraph",
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Write your paragraph here.</p>", "label": "Text" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "width", "label": "Width", "options": [ { "value": "standard", "label": "Standard" }, { "value": "wide", "label": "Wide (full width)" } ], "default": "standard" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "ph_label", "default": "Add image", "label": "Placeholder label" }
      ]
    },
    {
      "type": "duo",
      "name": "Image + Text",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "layout", "label": "Image position", "options": [ { "value": "image_left", "label": "Image left" }, { "value": "image_right", "label": "Image right" } ], "default": "image_left" },
        { "type": "text", "id": "subheading", "label": "Subheading" },
        { "type": "richtext", "id": "text", "default": "<p>Describe this step of the craft.</p>", "label": "Text" },
        { "type": "text", "id": "ph_label", "default": "Add image", "label": "Placeholder label" }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (upload / Shopify-hosted)" },
        { "type": "video_url", "id": "video_url", "label": "Or video URL (YouTube / Vimeo)", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "ph_label", "default": "Add video", "label": "Placeholder label" }
      ]
    },
    {
      "type": "quote",
      "name": "Pull quote",
      "settings": [
        { "type": "text", "id": "text", "default": "A short, memorable line.", "label": "Quote" },
        { "type": "text", "id": "cite", "label": "Attribution" }
      ]
    }
  ]
}
{% endschema %}
