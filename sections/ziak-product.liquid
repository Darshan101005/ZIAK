{{ 'section-ziak-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-ziak-product.css' | asset_url | stylesheet_tag }}
{{ 'ziak-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ziak-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'ziak-product.js' | asset_url }}" defer="defer"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>

<style>
  .shopify-section-group-header-group { display: none !important; }
  body { background-color: #FFFFFF !important; }

  #ziak-pdp-nav {
    position: relative !important;
    top: auto !important; left: auto !important; right: auto !important;
    background: #FFFFFF !important;
    border-bottom: 1px solid #E8E8E8 !important;
  }
  #ziak-pdp-nav .ziak-hero__nav-link,
  #ziak-pdp-nav .ziak-hero__nav-link--dropdown { color: #1A1A1A !important; }
  #ziak-pdp-nav .ziak-hero__nav-link--dropdown::after { border-top-color: #1A1A1A !important; }
  #ziak-pdp-nav .ziak-hero__nav-icon { color: #1A1A1A !important; opacity: 1 !important; }
  #ziak-pdp-nav .ziak-hero__nav-icon svg { stroke: #1A1A1A !important; }
  #ziak-pdp-nav .ziak-hero__logo-placeholder { color: #1A1A1A !important; opacity: 1 !important; }
  #ziak-pdp-nav .ziak-hero__logo-img { filter: none !important; }
  #ziak-pdp-nav .ziak-hero__mega-menu {
    position: fixed !important; top: auto !important; left: 0 !important; right: 0 !important; width: 100vw !important;
  }
</style>

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%}── Determine option positions ──{%- endcomment -%}
{%- liquid
  assign color_option_pos = 0
  assign size_option_pos = 0
  for option in product.options_with_values
    assign opt_lower = option.name | downcase
    if opt_lower == 'color' or opt_lower == 'colour'
      assign color_option_pos = option.position
    endif
    if opt_lower == 'size'
      assign size_option_pos = option.position
    endif
  endfor
-%}

<!-- ══════════ ANNOUNCEMENT + HEADER ══════════ -->
<div class="ziak-hero__announcement" id="ziak-pdp-announcement" style="background:#1A1A1A;color:#FFFFFF;">
  <span>{{ section.settings.announcement_text | default: 'FREE SHIPPING ON ALL ORDERS OVER ₹999 — SHOP ZIAK NOW' }}</span>
</div>

<div class="ziak-hero" id="ziak-pdp-hero" style="min-height:auto;background:#FFFFFF;">
  {%- render 'ziak-mobile-nav' -%}
    <nav class="ziak-hero__nav" id="ziak-pdp-nav" aria-label="Main navigation" style="background:#FFFFFF;border-bottom:1px solid #E8E8E8;">
    <div class="ziak-hero__nav-left">
      <div class="ziak-hero__dropdown-wrapper">
        <a href="{{ section.settings.link_men_url | default: '/collections/mens' }}" class="ziak-hero__nav-link ziak-hero__nav-link--dropdown" style="color:#1A1A1A;">MEN</a>
        {%- render 'ziak-mega-menu' -%}
      </div>
      <a href="{{ section.settings.link_about_url | default: '/pages/about' }}" class="ziak-hero__nav-link" style="color:#1A1A1A;">ABOUT</a>
    </div>

    <div class="ziak-hero__nav-center">
      <a href="{{ routes.root_url }}" class="ziak-hero__logo-placeholder" style="color:#1A1A1A;">
        {%- if settings.logo_svg_url != blank -%}
          <img src="{{ settings.logo_svg_url }}" alt="{{ shop.name | escape }}" class="ziak-hero__logo-img" width="120">
        {%- elsif settings.logo != blank -%}
          {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, class: 'ziak-hero__logo-img', width: 110 }}
        {%- else -%}
          ZIAK
        {%- endif -%}
      </a>
    </div>

    <div class="ziak-hero__nav-right">
      <a href="/pages/our-store" class="ziak-hero__nav-link" style="color:#1A1A1A;">STORES</a>
      <a href="/pages/contact" class="ziak-hero__nav-link" style="color:#1A1A1A;">HELP</a>
      <a href="/pages/wishlist" class="ziak-hero__nav-icon ziak-wish-link" aria-label="Wishlist" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="ziak-wish-count" data-ziak-wishlist-count style="display:none;">0</span>
      </a>
      <a href="{{ routes.account_url }}" class="ziak-hero__nav-icon" aria-label="Account" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M18 20a6 6 0 0 0-12 0"/><circle cx="12" cy="10" r="4"/></svg>
      </a>
      <a href="{{ routes.search_url }}" class="ziak-hero__nav-icon" aria-label="Search" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="ziak-hero__nav-icon" aria-label="Cart" style="color:#1A1A1A;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
      </a>
    </div>
  </nav>
</div>

<!-- ══════════ PRODUCT PAGE BODY ══════════ -->
<div class="ziak-pdp" id="ziak-pdp">
  <div class="ziak-pdp__wrap">

    <!-- Breadcrumb -->
    <nav class="ziak-pdp__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>›</span>
      {%- if product.collections.size > 0 -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span>›</span>
      {%- endif -%}
      <span>{{ product.title }}</span>
    </nav>

    <!-- ═══════════ HERO GRID ═══════════ -->
    <div class="ziak-pdp__hero">

      <!-- LEFT: Gallery -->
      <div class="ziak-pdp__gallery">
        <div class="ziak-pdp__thumbs">
          {%- for image in product.images -%}
            <div class="ziak-pdp__thumb {% if forloop.first %}is-active{% endif %}"
                 data-image-id="{{ image.id }}"
                 data-img-url="{{ image | image_url: width: 1200 }}"
                 data-img-alt="{{ image.alt | escape | default: product.title }}">
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
            </div>
          {%- endfor -%}
        </div>
        <div class="ziak-pdp__main-wrap">
          <img id="ziak-pdp-main-img" class="ziak-pdp__main-img"
               src="{{ product.featured_image | image_url: width: 1200 }}"
               alt="{{ product.featured_image.alt | escape | default: product.title }}"
               loading="eager">
          <button class="ziak-pdp__zoom-btn" id="ziak-pdp-zoom-btn" type="button" aria-label="Zoom image">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </button>
        </div>
      </div>

      <!-- RIGHT: Product info -->
      <div class="ziak-pdp__info">
        <p class="ziak-pdp__brand">{{ product.vendor | default: 'ZIAK' }}</p>
        <h1 class="ziak-pdp__title">{{ product.title }}</h1>

        <div class="ziak-pdp__price-row">
          <span class="ziak-pdp__price {% if current_variant.compare_at_price > current_variant.price %}ziak-pdp__price--sale{% endif %}" id="ziak-pdp-price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="ziak-pdp__compare" id="ziak-pdp-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="ziak-pdp__compare" id="ziak-pdp-compare" style="display:none;"></span>
          {%- endif -%}
        </div>
        <p class="ziak-pdp__tax">Inclusive of all taxes</p>

        <!-- Rating -->
        {%- assign rating_val = product.metafields.reviews.rating.value.rating | default: 4.7 -%}
        {%- assign review_count = product.metafields.reviews.rating_count.value | default: 0 -%}
        {%- assign rating_floor = rating_val | floor -%}
        {%- assign half_star_pos = rating_floor | plus: 1 -%}
        {%- assign has_half_star = false -%}
        {%- unless rating_val == rating_floor -%}
          {%- assign has_half_star = true -%}
        {%- endunless -%}
        <div class="ziak-pdp__rating">
          <span class="ziak-pdp__stars">
            {%- for i in (1..5) -%}
              {%- if i <= rating_floor -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- elsif i == half_star_pos and has_half_star -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0"><defs><linearGradient id="ziakHalf"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="#E0E0E0"/></linearGradient></defs><path fill="url(#ziakHalf)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#E0E0E0" stroke="#E0E0E0" stroke-width="0"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span class="ziak-pdp__rating-num">{{ rating_val }}</span>
          {%- if review_count > 0 -%}
            <span class="ziak-pdp__rating-count">({{ review_count }} reviews)</span>
          {%- endif -%}
        </div>

        <!-- Short description -->
        {%- assign short_desc = product.metafields.descriptors.subtitle.value | default: product.description | strip_html | truncatewords: 35 -%}
        <p class="ziak-pdp__short-desc">{{ short_desc }}</p>

        <!-- ── OPTIONS ── -->
        {%- for option in product.options_with_values -%}
          {%- assign opt_lower = option.name | downcase -%}
          {%- comment -%}Pre-compute current option value (Liquid can't use filters in brackets){%- endcomment -%}
          {%- if option.position == 1 -%}
            {%- assign current_opt_val = current_variant.option1 -%}
          {%- elsif option.position == 2 -%}
            {%- assign current_opt_val = current_variant.option2 -%}
          {%- else -%}
            {%- assign current_opt_val = current_variant.option3 -%}
          {%- endif -%}

          {%- if opt_lower == 'color' or opt_lower == 'colour' -%}
            <!-- Color swatches -->
            <div class="ziak-pdp__opt">
              <div class="ziak-pdp__opt-head">
                <p class="ziak-pdp__opt-label">COLOR: <span class="ziak-pdp__opt-value" id="ziak-pdp-color-label">{{ current_opt_val }}</span></p>
              </div>
              <div class="ziak-pdp__colors" id="ziak-pdp-colors">
                {%- for value in option.values -%}
                  {%- liquid
                    assign color_lower = value | downcase | strip
                    assign swatch_bg = '#888888'
                    case color_lower
                      when 'tan brown' or 'tan-brown'
                        assign swatch_bg = '#A0714A'
                      when 'tan'
                        assign swatch_bg = '#C8A96E'
                      when 'brown'
                        assign swatch_bg = '#6B4226'
                      when 'dark brown' or 'dark-brown'
                        assign swatch_bg = '#3E2723'
                      when 'black'
                        assign swatch_bg = '#1A1A1A'
                      when 'white'
                        assign swatch_bg = '#F5F5F5'
                      when 'red'
                        assign swatch_bg = '#C0392B'
                      when 'blue'
                        assign swatch_bg = '#2C3E50'
                      when 'navy'
                        assign swatch_bg = '#1B2A4A'
                      when 'grey' or 'gray'
                        assign swatch_bg = '#8E8E8E'
                      when 'beige'
                        assign swatch_bg = '#C8B88A'
                      when 'cream'
                        assign swatch_bg = '#F5F0E1'
                      when 'olive'
                        assign swatch_bg = '#556B2F'
                      when 'burgundy' or 'wine'
                        assign swatch_bg = '#722F37'
                      when 'cognac'
                        assign swatch_bg = '#9A463D'
                      when 'camel'
                        assign swatch_bg = '#C19A6B'
                      when 'cherry'
                        assign swatch_bg = '#9B111E'
                      when 'green'
                        assign swatch_bg = '#2D6A4F'
                    endcase
                  -%}
                  <button type="button"
                    class="ziak-pdp__swatch {% if value == current_opt_val %}is-active{% endif %}"
                    data-value="{{ value }}"
                    data-option-name="{{ option.name }}"
                    style="background-color: {{ swatch_bg }};"
                    title="{{ value }}"
                    aria-label="Color: {{ value }}">
                  </button>
                {%- endfor -%}
              </div>
            </div>

          {%- elsif opt_lower == 'size' -%}
            <!-- Size chips -->
            <div class="ziak-pdp__opt">
              <div class="ziak-pdp__opt-head">
                <p class="ziak-pdp__opt-label">SIZE: <span class="ziak-pdp__opt-value" id="ziak-pdp-size-label">{{ current_opt_val }}</span></p>
                <a href="{{ section.settings.size_guide_url | default: '/pages/size-guide' }}" class="ziak-pdp__size-guide">Size Guide</a>
              </div>
              <div class="ziak-pdp__sizes" id="ziak-pdp-sizes">
                {%- for value in option.values -%}
                  <button type="button"
                    class="ziak-pdp__size-chip {% if value == current_opt_val %}is-active{% endif %}"
                    data-value="{{ value }}"
                    data-option-name="{{ option.name }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>

          {%- else -%}
            <!-- Generic option (pill buttons) -->
            <div class="ziak-pdp__opt">
              <div class="ziak-pdp__opt-head">
                <p class="ziak-pdp__opt-label">{{ option.name }}: <span class="ziak-pdp__opt-value">{{ current_opt_val }}</span></p>
              </div>
              <div class="ziak-pdp__sizes">
                {%- for value in option.values -%}
                  <button type="button"
                    class="ziak-pdp__size-chip {% if value == current_opt_val %}is-active{% endif %}"
                    data-value="{{ value }}"
                    data-option-name="{{ option.name }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <!-- Trust badges row -->
        <div class="ziak-pdp__trust-row">
          <div class="ziak-pdp__mini-trust">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <div>
              <p class="ziak-pdp__mini-trust-label">Free Shipping</p>
              <p class="ziak-pdp__mini-trust-sub">On all orders</p>
            </div>
          </div>
          <div class="ziak-pdp__mini-trust">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
            <div>
              <p class="ziak-pdp__mini-trust-label">Easy Returns</p>
              <p class="ziak-pdp__mini-trust-sub">7-day easy returns</p>
            </div>
          </div>
          <div class="ziak-pdp__mini-trust">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div>
              <p class="ziak-pdp__mini-trust-label">Secure Payments</p>
              <p class="ziak-pdp__mini-trust-sub">100% secure</p>
            </div>
          </div>
        </div>

        <!-- Add to Cart -->
        <form id="ziak-pdp-form">
          <button type="button" id="ziak-pdp-atc" class="ziak-pdp__atc"
            data-variant-id="{{ current_variant.id }}"
            {% unless current_variant.available %}disabled{% endunless %}>
            <span class="ziak-pdp__spinner"></span>
            <span class="ziak-pdp__atc-label">{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</span>
          </button>
        </form>

        <!-- Wishlist -->
        <button type="button" id="ziak-pdp-wishlist" class="ziak-pdp__wish-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="ziak-pdp__wish-label">ADD TO WISHLIST</span>
        </button>
      </div>
    </div>

    <!-- ═══════════ TABS ═══════════ -->
    <div class="ziak-pdp__tabs-section">
      <div class="ziak-pdp__tabs-bar">
        <button type="button" class="ziak-pdp__tab-btn is-active" data-tab="description">DESCRIPTION</button>
        <button type="button" class="ziak-pdp__tab-btn" data-tab="material">MATERIAL & CARE</button>
        <button type="button" class="ziak-pdp__tab-btn" data-tab="shipping">SHIPPING & RETURNS</button>
        <button type="button" class="ziak-pdp__tab-btn" data-tab="reviews">REVIEWS ({{ review_count | default: 0 }})</button>
      </div>

      <div class="ziak-pdp__tab-body">
        <div class="ziak-pdp__tab-panels">
          <!-- Description -->
          <div class="ziak-pdp__tab-panel is-active" data-tab-panel="description">
            {{ product.description }}
            <p class="ziak-pdp__tab-sku" id="ziak-pdp-sku">SKU: {{ current_variant.sku | default: 'N/A' }}</p>
          </div>

          <!-- Material & Care -->
          <div class="ziak-pdp__tab-panel" data-tab-panel="material">
            {%- if section.settings.material_care_content != blank -%}
              {{ section.settings.material_care_content }}
            {%- else -%}
              <p>Premium full-grain leather upper with a smooth finish. Durable TPR sole provides excellent grip and longevity.</p>
              <ul>
                <li>Wipe with a soft damp cloth</li>
                <li>Apply leather conditioner monthly</li>
                <li>Store with shoe trees to maintain shape</li>
                <li>Avoid prolonged exposure to water</li>
              </ul>
            {%- endif -%}
          </div>

          <!-- Shipping & Returns -->
          <div class="ziak-pdp__tab-panel" data-tab-panel="shipping">
            {%- if section.settings.shipping_returns_content != blank -%}
              {{ section.settings.shipping_returns_content }}
            {%- else -%}
              <p><strong>Shipping:</strong> Free shipping on all prepaid orders. Standard delivery in 5–7 business days.</p>
              <p><strong>Returns:</strong> Easy 7-day returns and exchanges. Items must be unworn and in original packaging.</p>
              <ul>
                <li>Free return shipping on all orders</li>
                <li>Full refund to original payment method</li>
                <li>Exchange for a different size available</li>
              </ul>
            {%- endif -%}
          </div>

          <!-- Reviews -->
          <div class="ziak-pdp__tab-panel" data-tab-panel="reviews">
            <p>Customer reviews coming soon. Check back for ratings and feedback from verified buyers.</p>
          </div>
        </div>

        <!-- Quality badges sidebar -->
        <div class="ziak-pdp__qualities">
          <div class="ziak-pdp__quality">
            <span class="ziak-pdp__quality-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M11 3l1 6h6"/><path d="M2 9h20"/><path d="M13 3l-1 6H6"/></svg>
            </span>
            <div>
              <p class="ziak-pdp__quality-title">Premium Leather</p>
              <p class="ziak-pdp__quality-text">Selected for quality & durability</p>
            </div>
          </div>
          <div class="ziak-pdp__quality">
            <span class="ziak-pdp__quality-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
            <div>
              <p class="ziak-pdp__quality-title">Handcrafted</p>
              <p class="ziak-pdp__quality-text">Expertly crafted by skilled artisans</p>
            </div>
          </div>
          <div class="ziak-pdp__quality">
            <span class="ziak-pdp__quality-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </span>
            <div>
              <p class="ziak-pdp__quality-title">Comfort Fit</p>
              <p class="ziak-pdp__quality-text">Designed for all-day ease</p>
            </div>
          </div>
          <div class="ziak-pdp__quality">
            <span class="ziak-pdp__quality-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <div>
              <p class="ziak-pdp__quality-title">Built to Last</p>
              <p class="ziak-pdp__quality-text">Quality you can rely on</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- YOU MAY ALSO LIKE moved to its own section (ziak-product-recs) so it sits at the bottom of the page -->
    <!-- FEATURE STRIP moved to its own section (ziak-product-features) so it renders below the video section -->

  </div><!-- /.ziak-pdp__wrap -->
</div><!-- /.ziak-pdp -->

<!-- Zoom overlay (lightbox) -->
<div class="ziak-pdp__zoom-overlay" id="ziak-pdp-zoom-overlay">
  <button type="button" class="ziak-pdp__zoom-close" id="ziak-pdp-zoom-close" aria-label="Close zoom">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <img id="ziak-pdp-zoom-img" src="" alt="Zoomed product image">
</div>

<!-- Variant data for JavaScript -->
<script>
  window.__ziakProduct = {
    variants: {{ product.variants | json }},
    optionNames: {{ product.options | json }},
    currentVariant: {{ current_variant | json }},
    moneyFormat: {{ shop.money_format | json }}
  };
</script>

