        "rc3": { "type": "review", "settings": { "stars": 4, "text": "Classic brogues done right. Sharp detailing and they age gracefully.", "name": "Vikram P.", "location": "Bengaluru, India", "flag": "🇮🇳", "avatar_color": "#6E1B33" } },
